#!/usr/bin/env bash
# Regenerate manifests/plugins.toml from what is actually installed under
# $PLUGINS_DIR (default: ~/.config/omarchy/plugins). Phase B's bootstrap reads
# this file to reinstall every plugin on a fresh machine.
#
# The whole point of this tool is the refusal, not the manifest: a plugin
# whose HEAD commit no remote can currently serve is reported and left out,
# never recorded with a guess. A manifest that silently names an unpushed SHA
# looks like a guarantee ("clone this and you have what I have") while being
# none -- worse than no manifest, because nobody re-checks a file that already
# claims to be true. See task-12-report.md for concrete cases this caught on
# this machine: a plugin with no 'origin' remote at all, two with unpushed
# local commits, and two whose clones have drifted behind their upstream far
# enough that a tip-only check can no longer vouch for them.
#
# Reachability is decided ONLY by whether $commit is the exact tip of some ref
# (branch or tag) `git ls-remote "$url"` currently advertises -- the same
# thing tests/test_phase_a.sh's test_every_pin_is_reachable_from_its_remote
# checks afterwards, so a pin this script accepts is one that test cannot then
# disagree with. This is deliberately conservative: an older commit that is a
# true ancestor of the remote's current tip, but is not itself any ref's tip,
# cannot be told apart here from one that was never pushed at all -- ls-remote
# only advertises ref tips, never history. `git fetch --dry-run <url>
# <commit>` was tried as a fix for that gap and rejected: it reports success
# for a commit that exists ONLY in the local object store, never contacting
# the remote to check, because git resolves an already-local object without
# asking -- verified against wg-omarchy and mryll.meteobar's genuinely-unpushed
# commits below, both of which it falsely cleared. A verification method that
# can't tell "pushed" from "not pushed" is worse than none, so it was not used.
#
# Network reads only, and read-only in effect: `git ls-remote` against each
# plugin's own origin, nothing else. No fetch (confirmed above to be
# untrustworthy for this anyway), no push, no repo creation -- this script
# never touches a remote's state or a plugin's local object store.
#
# "Cannot check" (egress is down) is never conflated with "check failed"
# (egress is fine, this remote specifically didn't answer) -- same shape as
# tests/test_phase_a.sh's _gh_can_check / _github_reachable: a known-public,
# always-on endpoint is probed once per run, not once per plugin, and only a
# failure *there* is treated as "cannot check". When egress is down, a pin is
# still recorded if -- and only if -- this checkout's own remote-tracking
# data (cached locally from a previous, already-completed fetch; no network
# now) already shows the commit on an origin/* ref, and it is reported to
# stderr as UNVERIFIED rather than folded in silently. When egress is up but
# the check still fails, that is refused outright, the same as "not pushed".
set -Euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${SYNC_PLUGINS_OUT:-$REPO_ROOT/manifests/plugins.toml}"
PLUGINS_DIR="${PLUGINS_DIR:-$HOME/.config/omarchy/plugins}"
mkdir -p "$(dirname "$OUT")"

# A public, unauthenticated, always-on repo. A failure here means "egress is
# down", not "this plugin's remote is unreachable" -- probed at most once.
_egress_up() {
  timeout 8 git ls-remote https://github.com/git/git.git HEAD >/dev/null 2>&1
}

{
  echo "# Generated by bin/sync-plugins. Do not hand-edit -- re-run the"
  echo "# script instead; it will refuse anything it can't re-verify."
  echo "#"
  echo "# 'branch' is present only when 'commit' is not the tip of the"
  echo "# remote's default branch -- cloning default and checking out"
  echo "# 'commit' alone would not reproduce what's actually installed here."
  echo "# It may hold a tag name instead of a branch name; either checks out"
  echo "# with a plain 'git checkout <branch>' after a full clone."
  echo
} > "$OUT"

status=0
recorded=0
refused_ids=()
unverified_ids=()
egress_checked=0
egress_ok=1

for dir in "$PLUGINS_DIR"/*/; do
  [[ -d "$dir" ]] || continue
  base="$(basename "$dir")"
  [[ -f "$dir/manifest.json" ]] || continue

  id="$(jq -r '.id // empty' "$dir/manifest.json" 2>/dev/null)" || true
  if [[ -z "$id" ]]; then
    echo "SKIP $base: manifest.json has no usable .id" >&2
    continue
  fi

  if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "REFUSED $id: not a git checkout -- nothing to pin" >&2
    status=1; refused_ids+=("$id"); continue
  fi

  dirty="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l)"
  if [[ "$dirty" -ne 0 ]]; then
    echo "REFUSED $id: $dirty uncommitted change(s) in the working tree -- HEAD is not what's actually on disk" >&2
    status=1; refused_ids+=("$id"); continue
  fi

  if ! url="$(git -C "$dir" remote get-url origin 2>/dev/null)"; then
    remotes="$(git -C "$dir" remote -v 2>/dev/null | awk '/\(fetch\)/{printf "%s->%s ", $1, $2}')"
    echo "REFUSED $id: no 'origin' remote (has: ${remotes:-none}) -- no remote of record to install from" >&2
    status=1; refused_ids+=("$id"); continue
  fi

  commit="$(git -C "$dir" rev-parse HEAD 2>/dev/null)" || {
    echo "REFUSED $id: cannot resolve HEAD" >&2
    status=1; refused_ids+=("$id"); continue
  }

  ls_out=""
  live_ok=0
  if ls_out="$(timeout 10 git ls-remote "$url" 2>/dev/null)"; then
    live_ok=1
  fi

  branch=""

  if [[ "$live_ok" -eq 1 ]]; then
    if [[ -z "$ls_out" ]]; then
      echo "REFUSED $id: $url is reachable but advertises no refs at all" >&2
      status=1; refused_ids+=("$id"); continue
    fi

    # First exact match, in the order ls-remote prints (HEAD, then heads,
    # then everything else) -- so if $commit is the current default tip, the
    # "HEAD" pseudo-ref line wins over any other ref pointing at the same sha.
    match="$(awk -v c="$commit" '$1==c{print $2; exit}' <<<"$ls_out")"
    if [[ -z "$match" ]]; then
      echo "REFUSED $id: $commit is not the tip of any ref $url currently serves -- not pushed, or the clone has drifted behind upstream past what a tip-only check can confirm" >&2
      status=1; refused_ids+=("$id"); continue
    fi

    case "$match" in
      HEAD) branch="" ;;
      refs/heads/*) branch="${match#refs/heads/}" ;;
      refs/tags/*)
        branch="${match#refs/tags/}"
        branch="${branch%'^{}'}"
        ;;
      *) branch="$match" ;;
    esac
  else
    if [[ "$egress_checked" -eq 0 ]]; then
      egress_checked=1
      if _egress_up; then egress_ok=1; else egress_ok=0; fi
    fi

    if [[ "$egress_ok" -eq 0 ]]; then
      local_ref="$(git -C "$dir" for-each-ref --format='%(refname)' \
        --points-at="$commit" 'refs/remotes/origin/*' 2>/dev/null | head -1)"
      if [[ -z "$local_ref" ]]; then
        echo "REFUSED $id: could not reach $url (egress appears down) and no local remote-tracking ref already holds $commit -- cannot confirm any remote can serve this pin" >&2
        status=1; refused_ids+=("$id"); continue
      fi
      b="${local_ref#refs/remotes/origin/}"
      local_default="$(git -C "$dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
      local_default="${local_default#origin/}"
      if [[ -z "$local_default" || "$b" != "$local_default" ]]; then
        branch="$b"
      fi
      echo "UNVERIFIED $id: could not reach $url (egress appears down); recording $commit because a local remote-tracking ref (origin/$b, from a previous fetch) already holds it -- re-run sync-plugins once egress returns to get a live verification" >&2
      unverified_ids+=("$id")
    else
      echo "REFUSED $id: egress is up but $url could not be reached (bad URL, revoked access, or the repo is gone) -- refusing rather than guessing" >&2
      status=1; refused_ids+=("$id"); continue
    fi
  fi

  {
    printf '[[plugin]]\nid = "%s"\nurl = "%s"\ncommit = "%s"\n' "$id" "$url" "$commit"
    [[ -n "$branch" ]] && printf 'branch = "%s"\n' "$branch"
    printf '\n'
  } >> "$OUT"
  recorded=$((recorded + 1))
done

echo "sync-plugins: recorded $recorded plugin(s) in $OUT" >&2
if [[ "${#refused_ids[@]}" -gt 0 ]]; then
  echo "sync-plugins: REFUSED ${#refused_ids[@]} plugin(s), not recorded: ${refused_ids[*]}" >&2
fi
if [[ "${#unverified_ids[@]}" -gt 0 ]]; then
  echo "sync-plugins: ${#unverified_ids[@]} plugin(s) recorded UNVERIFIED (egress was down at generation time): ${unverified_ids[*]}" >&2
fi

exit "$status"
