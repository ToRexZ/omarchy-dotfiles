#!/usr/bin/env bash
# Exit 1 if an employer token appears in a repo's working tree (tracked or
# untracked, non-ignored), or its history.
#
# The OS username is capra_vhr and $HOME is /home/capra_vhr, so "the company name" alone is
# not a token -- it matches every absolute path and the capra_vhr.* plugin ids.
# Only the tokens below identify the employer. Matching is case-insensitive
# (EXAMPLE-ROS, example org, CI.EXAMPLE must not slip through) --
# verified this does not start matching capra_vhr: no token differs from it
# only by case.
#
# Fix round 2 widened the list. Every addition was a real employer string that
# passed the narrow list cleanly: the ROS packages example_nav and example_hmi, the
# second Jira project key PROJ-, the partner brand partnerco, and the build agent
# ci-build-agent-N. They are added as whole identifiers, never as a bare
# `company_` prefix: $HOME is /home/capra_vhr and the plugin ids are capra_vhr.*,
# so `company_` would match every absolute path in every repo and hand back the
# false-positive storm this narrow list exists to prevent. The issue key is anchored to a
# following digit so it only matches issue keys, and the agent token is anchored to the
# agent name rather than the hosting provider.
#
# Every check captures its producer's output into a variable and tests it with
# `[[ -n ]]`. It must never be written as `git grep ... | grep -q .`: under
# `set -o pipefail` that shape FAILS OPEN. `grep -q` exits at the first match,
# which closes the pipe; `git grep` is then killed by SIGPIPE and exits 141;
# pipefail makes 141 the pipeline's status; and the `if` is therefore false on
# exactly the repos that have the most to hide. Measured on this repo:
# `PIPESTATUS=141 0`, pipeline rc 141, gate exit 0, with 59 real hits in the
# tree. tests/test_scrub_gate.sh pins this against a fixture big enough to
# overflow the 64 KiB pipe buffer, which is what makes the race deterministic.
set -Euo pipefail

TOKENS='exampleorg|example-ros|example_ros|example_nav|example_hmi|ExampleVPN|example\.com|example-build|example-debug|example-stage|libexample|Example Org|ci\.example|10\.0\.0|PROJ-[0-9]|partnerco|ci-build-agent'

# This gate can never exit 0 against its own repo without this exclusion: the
# TOKENS list above and tests/test_scrub_gate.sh's fixtures both spell the
# tokens out as literal strings on purpose (a token you can't write down can't
# be tested), so a scan of this repo's own tree and history always matches its
# own definition and its own fixtures -- 18 structural hits, none of them an
# employer string that leaked, all of them this file and that one quoting the
# TOKENS regex back at itself.
#
# Excluded by pathspec, not by weakening TOKENS: the two files are named
# explicitly, so a real employer token anywhere else -- including in a
# *different* test file, or in this same file's own working tree outside these
# two paths -- still trips the gate. Run against any OTHER repo, neither
# pathspec matches anything (a strange target repo that happens to ship files
# at these exact two paths notwithstanding), so nothing is weakened elsewhere.
# tests/test_scrub_gate.sh's fixtures live under a mktemp dir with no
# bin/scrub-gate or tests/ of their own, so this exclusion is invisible to
# every existing test.
SELF_EXCLUDE=(':(exclude)bin/scrub-gate' ':(exclude)tests/test_scrub_gate.sh')

repo="${1:?usage: scrub-gate <repo-path>}"
cd "$repo" || exit 2

status=0

tree_hits="$(git grep -IinE "$TOKENS" -- . "${SELF_EXCLUDE[@]}" 2>/dev/null)" || true
if [[ -n "$tree_hits" ]]; then
  echo "employer tokens in working tree:" >&2
  printf '%s\n' "$tree_hits" >&2
  status=1
fi

# `git grep` only searches tracked files. A file that exists in the working
# tree but has not been `git add`ed yet (and is not gitignored) would
# otherwise sit there silently while the gate reports clean.
untracked_hits="$(git ls-files --others --exclude-standard -z -- . "${SELF_EXCLUDE[@]}" \
  | xargs -0 -r grep -HIinE "$TOKENS" -- 2>/dev/null)" || true
if [[ -n "$untracked_hits" ]]; then
  echo "employer tokens in untracked files:" >&2
  printf '%s\n' "$untracked_hits" >&2
  status=1
fi

history_hits="$(git log -p --all -- . "${SELF_EXCLUDE[@]}" 2>/dev/null | grep -inE "$TOKENS")" || true
if [[ -n "$history_hits" ]]; then
  echo "employer tokens in history:" >&2
  printf '%s\n' "$history_hits" | head -20 >&2
  status=1
fi

exit "$status"
