#!/usr/bin/env bash
# Exit non-zero if an employer token appears in a repo's working tree (tracked
# or untracked, non-ignored), or anywhere in its history -- diff content AND
# commit messages.
#
#   scrub-gate <repo-path>     0 clean | 1 tokens found | 2 usage | 3 NO VERDICT
#   scrub-gate --print-tokens  the assembled regex
#   scrub-gate --print-sources the files the list was read from
#
# ---------------------------------------------------------------------------
# THE TOKEN LIST IS DATA, AND IT DOES NOT LIVE IN THIS REPOSITORY.
#
# Earlier rounds kept the list here. Round 3 hid it from the scan by pathspec,
# which put a hole in the tool that travelled to every repo it was pointed at.
# Round 4 removed the pathspec and hid the list from the scan by assembling it
# around an empty variable instead -- which fixed the matching, and fixed
# nothing else: the tokens were still in a public file, in order, each one
# annotated with what it was. A regex that cannot match itself is not the same
# thing as a secret that is not written down.
#
# So the list is gone. It is supplied at runtime by a private overlay, and this
# repository ships only bin/scrub-tokens.example, which names nobody. That is
# also the right shape independently of secrecy: a second overlay, for a
# different employer, brings its own list and needs no change here.
#
# Sources, in order. (1) wins outright if set; (2) and (3) are unioned, so
# several overlays can contribute at once:
#
#   1. $SCRUB_GATE_TOKENS      one explicit file. If set it MUST exist.
#   2. $SCRUB_GATE_TOKENS_DIR  every regular file directly inside it.
#                              Default: ${XDG_CONFIG_HOME:-~/.config}/scrub-gate/tokens.d
#                              This is where an overlay stows its list.
#   3. $SCRUB_GATE_OVERLAYS    <overlay>/scrub-gate/tokens, for every overlay
#                              directly inside it.
#                              Default: ~/omarchy_configuration/overlays
#                              This is where an overlay keeps it before stow.
#
# Format: one extended-regex fragment per line. Blank lines and lines whose
# first non-blank character is # are ignored. Leading and trailing whitespace
# is stripped, so a fragment may contain spaces but may not start or end with
# one. The fragments are joined with | in the order read.
#
# WITH NO LIST THERE IS NO VERDICT. The gate exits 3 and says so, loudly, on
# stderr. It must never be possible to mistake "I was given nothing to look
# for" for "I looked and found nothing" -- that is the failure mode this whole
# tool exists to prevent, and a publication gate that returns 0 because its
# list went missing is worse than no gate at all, because it is trusted.
# Callers that test `scrub-gate x || refuse` therefore fail closed for free.
# ---------------------------------------------------------------------------
#
# The username trap: on this machine the OS username shares its first five
# characters with the company name, so $HOME and two plugin ids match a
# substring of one token. A list must never contain a bare prefix that the
# username satisfies -- it would report thousands of false positives on every
# absolute path and get the gate switched off. Matching is case-insensitive,
# so a shouted or title-cased spelling cannot slip through;
# tests/test_scrub_gate.sh checks the effective list against the real username
# rather than against a name written down here.
#
# Every check captures its producer's output into a variable and tests it with
# `[[ -n ]]`. It must never be written as `git grep ... | grep -q .`: under
# `set -o pipefail` that shape FAILS OPEN. `grep -q` exits at the first match,
# which closes the pipe; `git grep` is then killed by SIGPIPE and exits 141;
# pipefail makes 141 the pipeline's status; and the `if` is therefore false on
# exactly the repos that have the most to hide. Measured on this repo:
# `PIPESTATUS=141 0`, pipeline rc 141, gate exit 0, with 59 real hits in the
# tree. tests/test_scrub_gate.sh pins this against a fixture big enough to
# overflow the 64 KiB pipe buffer, which is what makes the race deterministic.
set -Euo pipefail

_token_files() {
  local f d
  if [[ -n "${SCRUB_GATE_TOKENS:-}" ]]; then
    printf '%s\n' "$SCRUB_GATE_TOKENS"
    return 0
  fi
  d="${SCRUB_GATE_TOKENS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/scrub-gate/tokens.d}"
  if [[ -d "$d" ]]; then
    for f in "$d"/*; do [[ -f "$f" ]] && printf '%s\n' "$f"; done
  fi
  d="${SCRUB_GATE_OVERLAYS:-$HOME/omarchy_configuration/overlays}"
  if [[ -d "$d" ]]; then
    for f in "$d"/*/scrub-gate/tokens; do [[ -f "$f" ]] && printf '%s\n' "$f"; done
  fi
  return 0
}

if [[ -n "${SCRUB_GATE_TOKENS:-}" && ! -f "${SCRUB_GATE_TOKENS:-}" ]]; then
  echo "scrub-gate: SCRUB_GATE_TOKENS points at no readable file: $SCRUB_GATE_TOKENS" >&2
  exit 2
fi

SOURCES=()
while IFS= read -r _f; do [[ -n "$_f" ]] && SOURCES+=("$_f"); done < <(_token_files)

TOKENS=""
for _f in ${SOURCES+"${SOURCES[@]}"}; do
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _line="${_line%$'\r'}"
    _line="${_line#"${_line%%[![:space:]]*}"}"   # lstrip
    _line="${_line%"${_line##*[![:space:]]}"}"   # rstrip
    [[ -z "$_line" || "$_line" == '#'* ]] && continue
    TOKENS="${TOKENS:+$TOKENS|}$_line"
  done < "$_f"
done

if [[ -z "$TOKENS" ]]; then
  {
    echo "scrub-gate: NO TOKEN LIST FOUND -- NO VERDICT (exit 3)."
    echo "  This is not a clean result. Nothing was scanned for, so nothing was found."
    echo "  Looked in:"
    echo "    \$SCRUB_GATE_TOKENS      = ${SCRUB_GATE_TOKENS:-<unset>}"
    echo "    \$SCRUB_GATE_TOKENS_DIR  = ${SCRUB_GATE_TOKENS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/scrub-gate/tokens.d}"
    echo "    \$SCRUB_GATE_OVERLAYS    = ${SCRUB_GATE_OVERLAYS:-$HOME/omarchy_configuration/overlays}/*/scrub-gate/tokens"
    echo "  The list is supplied by a private overlay; see bin/scrub-tokens.example"
    echo "  for the format. Until one is present this gate cannot clear anything."
  } >&2
  exit 3
fi

case "${1:-}" in
  --print-tokens)  printf '%s\n' "$TOKENS"; exit 0 ;;
  --print-sources) printf '%s\n' ${SOURCES+"${SOURCES[@]}"}; exit 0 ;;
esac

repo="${1:?usage: scrub-gate <repo-path> | scrub-gate --print-tokens | --print-sources}"
cd "$repo" || exit 2

status=0

tree_hits="$(git grep -IinE "$TOKENS" -- . 2>/dev/null)" || true
if [[ -n "$tree_hits" ]]; then
  echo "employer tokens in working tree:" >&2
  printf '%s\n' "$tree_hits" >&2
  status=1
fi

# `git grep` only searches tracked files. A file that exists in the working
# tree but has not been `git add`ed yet (and is not gitignored) would
# otherwise sit there silently while the gate reports clean.
untracked_hits="$(git ls-files --others --exclude-standard -z -- . \
  | xargs -0 -r grep -HIinE "$TOKENS" -- 2>/dev/null)" || true
if [[ -n "$untracked_hits" ]]; then
  echo "employer tokens in untracked files:" >&2
  printf '%s\n' "$untracked_hits" >&2
  status=1
fi

# `git log -p --all` with NO pathspec. A pathspec here does two damaging
# things beyond the exclusion itself. It drops whole commits that touch only
# the listed paths, and -- the one that matters -- it drops every EMPTY
# commit's message, because a commit that touches no path survives no path
# filter. Commit messages are exactly where project names leak ("rollout to
# <host>", "fix for <issue key>"); Task 10's history rewrite had to add a
# message callback for that reason. Measured: a commit made with
# `--allow-empty -m "rollout to <host>"` was caught by the unfiltered scan and
# missed by the filtered one. `-p` prints the header, the message and the diff,
# so one unfiltered pass covers all three.
history_hits="$(git log -p --all 2>/dev/null | grep -inE "$TOKENS")" || true
if [[ -n "$history_hits" ]]; then
  echo "employer tokens in history:" >&2
  printf '%s\n' "$history_hits" | head -20 >&2
  status=1
fi

exit "$status"
