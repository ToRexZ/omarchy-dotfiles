+    /// The alias list below renders as a 72-column shortcut. It used to set the
+    /// width of the shortcut column for every row, overflowing the panel, so
+    /// ratatui wrapped every description onto a row of its own at column zero -
+    /// flush left, under a heading that was indented.
+    #[test]
+    fn wide_binding_does_not_unindent_every_description() {
+        let app = app_with_keys(
+            r#"
+[keys]
+split_vertical = "prefix+v"
+resize_mode = ["prefix+ctrl+left", "prefix+ctrl+down", "prefix+ctrl+up", "prefix+ctrl+right"]
+"#,
+        );
+
+        let wrap_width = 96;
+        let rows = rendered_rows(&app, wrap_width);
+
+        for row in &rows {
+            assert!(
+                row.chars().count() <= wrap_width,
+                "row overflows the panel and wraps back to column zero: {row:?}"
+            );
+            assert!(
+                row.is_empty() || row.starts_with(' '),
+                "row sits flush against the border: {row:?}"
+            );
+        }
+
+        // A shortcut that fits the column shares its row with its description.
+        assert!(
