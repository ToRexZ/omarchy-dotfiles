# herdr with the keybinds panel (prefix+?) patched for readability.
#
# Tracks aur/herdr. The only differences from the upstream PKGBUILD are the
# rename to herdr-patched, the extra `source` entry, and the `patch` call in
# prepare(). The rename is deliberate: as plain `herdr` this build would be
# silently replaced by the stock package on the next `yay -Syu`.
#
# Bumping pkgver: diff against the upstream PKGBUILD for build changes, refresh
# the tarball checksum with `updpkgsums`, then re-run
# ../../install-scripts/herdr.sh. If the patch no longer applies, upstream has
# reworked src/ui/keybind_help.rs and the change needs redoing by hand.

_upstream=herdr
pkgname=herdr-patched
pkgver=0.8.2
pkgrel=1
pkgdesc='Terminal workspace manager for AI coding agents (readable keybinds panel)'
arch=('x86_64' 'aarch64')
url='https://herdr.dev'
license=('AGPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'zig0.15')
provides=('herdr')
conflicts=('herdr')
source=("${_upstream}-${pkgver}.tar.gz::https://github.com/ogulcancelik/${_upstream}/archive/refs/tags/v${pkgver}.tar.gz"
        'keybind-help-readability.patch')
# The patch is versioned in this repo, so git is what guards its integrity.
sha256sums=('60453051025ee44ebf055d26cdaf665a0accd99a992cddd22c166a26c49cd161'
            'SKIP')
# Where zig0.15-bin puts its compiler. HERDR_ZIG overrides it, so the package
# can also be built against a zig 0.15 that is not installed system-wide -- pair
# it with `makepkg -d`, since makedepends is still checked:
#   HERDR_ZIG=/path/to/zig makepkg -d
_zig="${HERDR_ZIG:-/opt/zig0.15/zig}"

prepare() {
  cd "${_upstream}-${pkgver}"

  patch -p1 < "${srcdir}/keybind-help-readability.patch"

  export CARGO_HOME="${srcdir}/cargo-home"
  export ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-cache"
  export PATH="${_zig%/*}:${PATH}"

  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"

  # libghostty-vt pulls its own zig dependencies, and those transitively pull
  # more, so keep fetching until a pass turns up no new URLs.
  local zig_seen="${srcdir}/zig-fetch-seen"
  local zig_urls="${srcdir}/zig-fetch-urls"
  : > "${zig_seen}"
  while true; do
    find vendor/libghostty-vt "${ZIG_GLOBAL_CACHE_DIR}" -name build.zig.zon \
      -exec sed -n 's/^[[:space:]]*\.url = "\(.*\)",/\1/p' {} + 2>/dev/null \
      | sort -u > "${zig_urls}"

    local fetched=0
    while IFS= read -r zig_url; do
      if grep -Fxq "${zig_url}" "${zig_seen}"; then
        continue
      fi
      local zig_ok=0
      for _ in 1 2 3; do
        if "${_zig}" fetch --global-cache-dir "${ZIG_GLOBAL_CACHE_DIR}" "${zig_url}"; then
          zig_ok=1
          break
        fi
        sleep 2
      done
      (( zig_ok == 1 ))
      printf '%s\n' "${zig_url}" >> "${zig_seen}"
      fetched=1
    done < "${zig_urls}"

    (( fetched == 0 )) && break
  done
}

build() {
  cd "${_upstream}-${pkgver}"

  export CARGO_HOME="${srcdir}/cargo-home"
  export ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-cache"
  export PATH="${_zig%/*}:${PATH}"
  export ZIG="${_zig}"
  export HERDR_BUILD_CHANNEL=stable
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname}"
  export CARGO_TARGET_DIR=target

  cargo build --release --frozen
}

check() {
  cd "${_upstream}-${pkgver}"

  export CARGO_HOME="${srcdir}/cargo-home"
  export ZIG_GLOBAL_CACHE_DIR="${srcdir}/zig-cache"
  export PATH="${_zig%/*}:${PATH}"
  export ZIG="${_zig}"
  export CARGO_TARGET_DIR=target

  # Only the patched area. The full suite spins up servers and PTYs, which is
  # more than this rebuild needs to prove.
  cargo test --frozen keybind_help
}

package() {
  cd "${_upstream}-${pkgver}"

  install -Dm755 "target/release/${_upstream}" "${pkgdir}/usr/bin/${_upstream}"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  install -d "${pkgdir}/usr/share/bash-completion/completions"
  install -d "${pkgdir}/usr/share/fish/vendor_completions.d"
  install -d "${pkgdir}/usr/share/zsh/site-functions"
  "target/release/${_upstream}" completion bash > "${pkgdir}/usr/share/bash-completion/completions/${_upstream}"
  "target/release/${_upstream}" completion fish > "${pkgdir}/usr/share/fish/vendor_completions.d/${_upstream}.fish"
  "target/release/${_upstream}" completion zsh > "${pkgdir}/usr/share/zsh/site-functions/_${_upstream}"
}
